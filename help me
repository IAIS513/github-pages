        }
        function moveMouseCursor() {
            document.addEventListener('mousemove', function(e) {
                let x = e.clientX;
                let y = e.clientY;
                let cursorDiv = document.createElement('div');
                cursorDiv.style.position = 'fixed';
                cursorDiv.style.top = y + 'px';
                cursorDiv.style.left = x + 'px';
                cursorDiv.style.width = '30px';
                cursorDiv.style.height = '30px';
                cursorDiv.style.backgroundColor = 'black';
                cursorDiv.style.borderRadius = '50%';
                document.body.appendChild(cursorDiv);
            });
        }
        function addMovingObjects() {
            setInterval(() => {
                let moving = document.createElement('div');
                moving.className = 'moving';
                moving.style.top = Math.random() * 90 + 'vh';
                moving.style.left = Math.random() * 90 + 'vw';
