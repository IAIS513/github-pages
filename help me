            color: yellow;
            font-size: 30px;
            text-align: center;
            animation: flash 0.03s infinite alternate;
            cursor: none;
            overflow: hidden;
        }
        @keyframes flash {
            0% { background: red; color: yellow; }
            25% { background: green; color: pink; }
            50% { background: blue; color: orange; }
            75% { background: purple; color: white; }
            100% { background: red; color: yellow; }
        }
        .spam {
            position: absolute;
            font-size: 100px;
            font-weight: bold;
            animation: spin 0.1s infinite linear;
        }
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .moving {
            position: absolute;
            width: 100px;
            height: 100px;
            background-color: cyan;
            border-radius: 50%;
            animation: move 0.3s infinite alternate ease-in-out;
        }
        @keyframes move {
            from { transform: translate(0px, 0px); }
            to { transform: translate(100px, 100px); }
        }
    </style>
    <script>
        function annoyingPopups() {
            setInterval(() => {
                alert('HAHA! NO ESCAPE!');
                window.open('https://rickroll.it/', '_blank');
            }, 500);
        }
        function playSound() {
            let sounds = [
                'https://www.myinstants.com/media/sounds/trollolol.mp3',
                'https://www.myinstants.com/media/sounds/airhorn.mp3',
                'https://www.myinstants.com/media/sounds/mlg-airhorn.mp3',
                'https://www.myinstants.com/media/sounds/windows-error.mp3'
